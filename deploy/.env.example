# Notix — server environment variables (production).
# Copy to /etc/notix/notix.env (chmod 600, owner root) and fill in the values.
# Never commit the real file. Nested keys use "__" (e.g. Stripe__SecretKey = Stripe:SecretKey).

ASPNETCORE_ENVIRONMENT=Production

# Database
ConnectionStrings__Default=Data Source=/var/lib/notix/notix.db

# Files and logs (outside the public web folder)
Storage__Root=/var/lib/notix/storage
Logs__Root=/var/lib/notix/logs

# Public URL of the site, without trailing slash (e.g. https://notix.duckdns.org)
App__BaseUrl=

# Administrator account created at first start
Admin__Email=
Admin__Password=

# Stripe (test mode keys: sk_test_..., whsec_...)
Stripe__SecretKey=
Stripe__WebhookSecret=

# Google reCAPTCHA v2
Recaptcha__SiteKey=
Recaptcha__SecretKey=

# Brevo SMTP (STARTTLS on 587). Leave Smtp__Host empty to write e-mails to the log instead.
Smtp__Host=smtp-relay.brevo.com
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__FromEmail=
Smtp__FromName=Notix

# Contact form recipient
Contact__TeamEmail=

# Demo data (keep false in production)
Seed__DemoData=false
